# Copy to .env on the server (never commit .env). Only OPENAI_API_KEY is required.
OPENAI_API_KEY=sk-...

# Model used for extraction. Must support PDF input and structured outputs.
OPENAI_MODEL=gpt-4.1-mini

# Abuse and cost protection for the public demo. Each AI call counts once:
# a website profile, each drafted or uploaded logframe, each Ask Eval360 question, each AI report.
AI_LIMIT_PER_IP_DAY=40
AI_LIMIT_TOTAL_DAY=500
AI_MAX_PDF_MB=8
AI_MAX_TEXT_CHARS=150000
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_SECONDS=180

# Any random string; used to hash visitor IPs for the daily limit.
APP_SALT=change-me

# Local testing without a key: returns a fixed mock extraction.
# AI_MOCK=1

# ── Demo links (step two: "we will create a system demo, and send you a link") ─
# A visitor turns their reviewed set-up into an unguessable URL. The reviewed
# framework is stored under storage/share/; their uploaded documents never are.
# Everything below is optional — sharing works with none of it set.

# Where to email a new demo, a first open and a meeting click. Without this,
# nothing is sent and the pipeline page is the only way to see activity.
# SHARE_NOTIFY_EMAIL=eval360@vantageafricaleaders.com
# SHARE_NOTIFY_FROM=no-reply@eval360.tech

# Booking page for the discovery meeting (step three). Without it, the demo
# shows the email and phone below instead.
# SHARE_MEETING_URL=https://calendly.com/vantage/eval360-discovery

# Shown to visitors as the way to reach you.
SHARE_CONTACT_EMAIL=eval360@vantageafricaleaders.com
SHARE_CONTACT_PHONE=0105064544

# 16 characters or more opens api/pipeline.php?key=… — who built a demo, who
# opened it, who asked for a meeting. Unset, that page returns 404.
# SHARE_ADMIN_KEY=

# How long a link lasts before it is deleted, links one visitor may create per
# day, and the largest set-up that may be shared.
SHARE_TTL_DAYS=90
SHARE_LIMIT_PER_IP_DAY=10
SHARE_MAX_PAYLOAD_KB=1500

# SHARE_GATE=0 opens shared links without asking for a contact first.
# SHARE_DISABLE=1 switches demo links off altogether.
# SHARE_BASE_URL is only needed if the server cannot work out its own address.
